DATABASE_URL=
JWT_SECRET=
PORT=
GROQ_API_KEY=
FRONTEND_URL=

# Set to true for ONE start to create or alter tables, then remove it.
# Required on a fresh database, including the first deploy: without it the
# server starts fine and every query fails because no tables exist.
# Leaving it on runs ALTER against a live schema on every restart.
RUN_DB_SYNC=
